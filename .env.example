# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_HTTP_RESUMABILITY=auto       # auto | enabled | disabled (default: auto; auto enables in stateful mode)
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=1000  # Max retained events per stream (default: 1000)
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # Event retention TTL in ms (default: 300000 / 5 min)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateless          # auto | stateful | stateless (schema default: auto; auto resolves to stateful)

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=     # Optional: max same-level log lines per window (disabled when unset)
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000 # Rate-limit window in ms (default: 60000)

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── Server-specific ──────────────────────────────────────────────────
# POKEAPI_BASE_URL=https://pokeapi.co/api/v2  # Base URL for PokéAPI. For high-volume or hosted
                                              # deployments, run the official Docker image
                                              # (https://github.com/PokeAPI/pokeapi) locally and
                                              # point this at it — consistent with PokéAPI's Fair
                                              # Use Policy (https://pokeapi.co/docs/v2#fairuse).
# POKEAPI_CACHE_TTL_SECONDS=21600             # How long to cache PokéAPI responses (default: 6 h)
# POKEAPI_REQUEST_TIMEOUT_MS=10000            # Per-request timeout in ms (default: 10 s)
