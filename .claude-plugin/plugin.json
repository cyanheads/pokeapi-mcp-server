{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "pokeapi-mcp-server",
  "version": "0.1.8",
  "description": "Look up Pokémon, moves, abilities, items, natures, and type matchups from PokéAPI v2 via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/pokeapi-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/pokeapi-mcp-server.git",
  "license": "Apache-2.0",
  "keywords": [
    "pokemon",
    "pokeapi",
    "game-data",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "ai-agent"
  ],
  "mcpServers": {
    "pokeapi-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/pokeapi-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
